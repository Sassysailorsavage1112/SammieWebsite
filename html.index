<!-- =========================
PROCESS
========================== -->

<section id="process" class="section process-section">

<div class="section-heading">

<div class="section-label">
THE PROCESS
</div>

<h2>
From idea to
<span>launch.</span>
</h2>

</div>


<div class="process-grid">

<div class="process-step">

<div class="process-number">
01
</div>

<h3>
Tell Me Your Idea
</h3>

<p>
Tell me what you want your website
to accomplish and the style you're after.
</p>

</div>


<div class="process-step">

<div class="process-number">
02
</div>

<h3>
Design
</h3>

<p>
I'll create the visual direction,
layout, colors, and overall experience.
</p>

</div>


<div class="process-step">

<div class="process-number">
03
</div>

<h3>
Build
</h3>

<p>
Your website gets custom coded and
optimized for phones, tablets, and desktops.
</p>

</div>


<div class="process-step">

<div class="process-number">
04
</div>

<h3>
Launch
</h3>

<p>
Your new website goes live and is ready
for the world to see.
</p>

</div>

